<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_vac_event_stage_form" model="ir.ui.view">
        <field name="name">vac.event.stage.form</field>
        <field name="model">vac.event.stage</field>
        <field name="arch" type="xml">
            <form string="Event Stage">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="fold"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Describe this stage..." nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_vac_event_stage_list" model="ir.ui.view">
        <field name="name">vac.event.stage.list</field>
        <field name="model">vac.event.stage</field>
        <field name="arch" type="xml">
            <list string="Event Stages" editable="bottom" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold" widget="boolean_toggle"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vac_event_stage" model="ir.actions.act_window">
        <field name="name">Event Stages</field>
        <field name="res_model">vac.event.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first event stage
            </p>
            <p>
                Define stages to organize your event workflow (e.g., Planning, Confirmed, In Progress, Completed).
            </p>
        </field>
    </record>
</odoo>