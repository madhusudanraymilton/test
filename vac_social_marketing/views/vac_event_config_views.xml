<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ========================================== -->
    <!-- EVENT STAGE VIEWS -->
    <!-- ========================================== -->
    
    <!-- Event Stage Form View -->
    <record id="vac_event_stage_view_form" model="ir.ui.view">
        <field name="name">vac.event.stage.form</field>
        <field name="model">vac.event.stage</field>
        <field name="arch" type="xml">
            <form string="Event Stage">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="fold"/>
                            <field name="active"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Stage description..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Event Stage List View (Odoo 18) -->
    <record id="vac_event_stage_view_list" model="ir.ui.view">
        <field name="name">vac.event.stage.list</field>
        <field name="model">vac.event.stage</field>
        <field name="arch" type="xml">
            <list string="Event Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="fold"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    
    <!-- Event Stage Action -->
    <record id="vac_event_stage_action" model="ir.actions.act_window">
        <field name="name">Event Stages</field>
        <field name="res_model">vac.event.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first event stage!
            </p>
            <p>
                Stages represent the lifecycle of events (Draft, Published, Completed, etc.)
            </p>
        </field>
    </record>
    
    
</odoo>