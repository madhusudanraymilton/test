            <div class="fw-semibold" t-esc="lead.branch_service_id.name or ''"/>
        </div>
        <div class="col-md-6" t-if="lead.current_va_disability_rating">
            <span class="text-muted small">Current VA Disability Rating</span>
            <div class="fw-semibold" t-esc="int(lead.current_va_disability_rating)"/>
        </div>
        <div class="col-md-6">
            <span class="text-muted small">US Veteran</span>
            <div class="fw-semibold" t-esc="'Yes' if lead.is_veteran else 'No'"/>
        </div>
        <div class="col-md-6">
            <span class="text-muted small">Has DD214 Access</span>
            <div class="fw-semibold" t-esc="'Yes' if (lead.has_dd214_copy or lead.has_dd214_access) else 'No'"/>
        </div>
        <div class="col-md-6" t-if="lead.is_current_client">
            <span class="text-muted small">Current VAC Client</span>
            <div class="fw-semibold">Yes</div>
        </div>
        <div class="col-md-6" t-if="lead.physical_address">
            <span class="text-muted small">Physical Address</span>
            <div class="fw-semibold" t-esc="lead.physical_address or ''"/>
        </div>
        <div class="col-md-6">
            <span class="text-muted small">Event Date</span>
            <div class="fw-semibold" t-field="event.date"
                 t-options="{'widget': 'date'}"/>
        </div>
    </div>
</div>
<div class="d-flex justify-content-center gap-3 mt-3">
    <a t-attf-href="/event/invite/#{event.id}" class="btn btn-outline-secondary">
        <i class="fa fa-arrow-left me-2"/>Back to Event
    </a>
    <a href="/events" class="btn" style="background:#714B67;color:#fff;">
        <i class="fa fa-calendar me-2"/>All Events
    </a>
</div>
</div>
</div>
</div>
</div>
</div>
</section>
</div>
</t>
</template>


