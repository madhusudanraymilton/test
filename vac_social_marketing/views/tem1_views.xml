        .ev-status-badge { width:100%; border-radius:10px; padding:0.85rem 1.1rem; font-size:0.88rem; font-weight:600; display:flex; align-items:center; gap:0.85rem; }
        .ev-status-icon { width:36px; height:36px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1rem; flex-shrink:0; }
        .ev-status-text { display:flex; flex-direction:column; gap:0.1rem; }
        .ev-status-label { font-size:0.92rem; font-weight:700; line-height:1.2; }
        .ev-status-sub { font-size:0.75rem; font-weight:400; opacity:0.75; }
