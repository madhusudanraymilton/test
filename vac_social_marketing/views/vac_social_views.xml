    <record id="vac_social_office_view_kanban" model="ir.ui.view">
        <field name="name">vac.social.office.kanban</field>
        <field name="model">vac.social.office</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" sample="1"
                    group_expand="_read_group_stage_ids">
                <field name="title"/>
                <field name="stage_id"/>
                <field name="published"/>
                <field name="date_begin"/>
                <field name="date_end"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="title"/></strong>
                            <div class="text-muted small">
                                <field name="date_begin" widget="date"/> → <field name="date_end" widget="date"/>
                            </div>
                            <div class="mt-1">
                                <span t-attf-class="badge #{
                                    record.stage_id.raw_value and (
                                        record.stage_id.value.toLowerCase().includes('ongoing') ? 'text-bg-primary' :
                                        record.stage_id.value.toLowerCase().includes('published') ? 'text-bg-success' :
                                        record.stage_id.value.toLowerCase().includes('completed') ? 'text-bg-info' :
                                        record.stage_id.value.toLowerCase().includes('cancelled') ? 'text-bg-danger' :
                                        'text-bg-secondary'
                                    ) or 'text-bg-secondary'
                                }">
                                    <t t-esc="record.stage_id.value or 'Draft'"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!--  =================================================  -->
    <!--  OFFICES ACTION                                       -->
    <!--  =================================================  -->
    <record id="vac_social_office_action" model="ir.actions.act_window">
        <field name="name">Offices</field>
        <field name="res_model">vac.social.office</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Offices campaign!</p>
            <p>Manage Offices marketing campaigns and collect leads through a custom registration form.</p>
        </field>
    </record>

</odoo>
