        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('vac_event_lead_view_kanban')}),
            (0, 0, {'view_mode': 'list',   'view_id': ref('vac_event_lead_view_list')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No event leads for Chris French yet!</p>
        </field>
