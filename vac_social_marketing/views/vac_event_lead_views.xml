        <field name="view_mode">kanban,list,form</field>
        <field name="domain" eval="[('event_id', '!=', False), ('sponsor_id', '=', ref('sponsor_webinar'))]"/>
        <field name="context" eval="{'hide_social_stage': True, 'default_platform': 'event', 'default_sponsor_id': ref('sponsor_webinar')}"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('vac_event_lead_view_kanban')}),
