    <!-- ── Social Media Leads (only leads linked to FB or Instagram) ── -->
    <record id="vac_event_lead_action_social_only" model="ir.actions.act_window">
        <field name="name">Social Media Leads</field>
        <field name="res_model">vac.event.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">['&amp;', ('social_stage_id', '!=', False), '|', '|', '|', ('social_fb_id', '!=', False), ('social_ig_id', '!=', False), ('social_office_id', '!=', False), ('platform', 'in', ['facebook', 'instagram', 'office'])]</field>
        <field name="context">{'hide_social_stage': False, 'default_platform': 'facebook'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('vac_event_lead_view_social_kanban')}),
            (0, 0, {'view_mode': 'list',   'view_id': ref('vac_event_lead_view_social_list')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No social media leads yet!</p>
            <p>Leads generated through Facebook, Instagram, or Offices campaign links will appear here.</p>
        </field>
    </record>

</odoo>