<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================= -->
    <!-- LEAD KANBAN VIEW -->
    <!-- ================================================= -->
    <record id="vac_event_lead_view_kanban" model="ir.ui.view">
        <field name="name">vac.event.lead.kanban</field>
        <field name="model">vac.event.lead</field>
        <field name="arch" type="xml">
            <kanban class="o_lead_kanban_view" 
                    default_group_by="stage_id"
                    quick_create="false"
                    sample="1">

                <field name="name"/>
                <field name="email"/>
                <field name="mobile"/>
                <field name="whatsapp_number"/>
                <field name="branch_service_id"/>
                <field name="bam_user_id" options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_search_more': True}"/>
                <field name="sponsor_id"/>
                <field name="stage_id"/>
                <field name="activity_ids"/>
                <field name="activity_state"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card d-flex flex-column">
                            
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary fw-bold">
                                        <field name="name"/>
                                    </div>
                                </div>
                            </div>

                            <div class="o_kanban_card_content">
                                <div class="d-flex align-items-center mb-1">
                                    <i class="fa fa-envelope me-2 text-muted" title="Email"/>
                                    <field name="email" widget="email"/>
                                </div>

                                <div t-if="record.mobile.value" class="d-flex align-items-center mb-1">
                                    <i class="fa fa-phone me-2 text-muted" title="Phone"/>
                                    <field name="mobile" widget="phone"/>
                                </div>

                                <div t-if="record.branch_service_id.value" class="d-flex align-items-center mb-1">
                                    <i class="fa fa-building me-2 text-muted" title="Branch/Service"/>
                                    <field name="branch_service_id"/>
                                </div>

                                <div t-if="record.sponsor_id.value" class="d-flex align-items-center mb-1">
                                    <i class="fa fa-handshake-o me-2 text-muted" title="Sponsor"/>
                                    <field name="sponsor_id"/>
                                </div>

                            </div>

                            <div class="o_kanban_card_footer mt-auto">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex">
                                        <field t-if="record.bam_user_id.value" 
                                               name="bam_user_id" 
                                               widget="many2one_avatar_user"
                                               options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_search_more': True}"/>
                                    </div>
                                    
                                    <div class="d-flex ms-auto">
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </t>
                </templates>

            </kanban>
        </field>
    </record>


    <!-- ================================================= -->
    <!-- LEAD FORM VIEW - PROPER ODOO 18 STRUCTURE -->
    <!-- ================================================= -->
    <record id="vac_event_lead_view_form" model="ir.ui.view">
        <field name="name">vac.event.lead.form</field>
        <field name="model">vac.event.lead</field>
        <field name="arch" type="xml">
            <form string="Lead" class="o_lead_form_view">
                
                <header>
                    <!-- Social leads: show social_stage_id statusbar -->
                    <field name="social_stage_id"
                           widget="statusbar"
                           options="{'clickable': '1'}"
                           invisible="platform not in ('facebook', 'instagram', 'office') and not social_fb_id and not social_ig_id and not social_office_id"/>
                    <!-- Event leads: show stage_id statusbar -->
                    <field name="stage_id"
                           widget="statusbar"
                           options="{'clickable': '1'}"
                           invisible="platform in ('facebook', 'instagram', 'office') or social_fb_id or social_ig_id or social_office_id"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Smart buttons will go here -->
                    </div>

                    <field name="active" invisible="1"/>

                    <div class="oe_title">
                        <label for="name" string="Lead Name"/>
                        <h1>
                            <field name="name" 
                                   class="text-break" 
                                   options="{'line_breaks': False}" 
                                   widget="text" 
                                   placeholder="e.g. John Doe"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Contact Information">
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="email" widget="email"/>
                            <field name="mobile" widget="phone"/>
                            <field name="whatsapp_number"/>
                            <field name="birthday"/>
                            <field name="age"/>
                        </group>

                        <group string="Assignment and Tracking">
                            <field name="branch_service_id"/>
                            <field name="bam_user_id" options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_search_more': True}"
                                   invisible="1"/>
                            <field name="event_id"
                                   domain="sponsor_id and [('sponsor_id', '=', sponsor_id)] or []"
                                   invisible="platform in ('facebook', 'instagram', 'office') or social_fb_id or social_ig_id or social_office_id"/>
                            <field name="sponsor_id"
                                   widget="vac_no_search_more_many2one"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_search_more': True}"
                                   invisible="platform in ('facebook', 'instagram', 'office') or social_fb_id or social_ig_id or social_office_id"/>
                            <field name="social_fb_id" invisible="platform != 'facebook'"/>
                            <field name="social_ig_id" invisible="platform != 'instagram'"/>
                            <field name="social_office_id" invisible="platform != 'office'"/>
                            <field name="platform"/>
                            <field name="current_va_disability_rating"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Veteran Details" name="veteran_details">
                            <group>
                                <field name="is_current_client"/>
                                <field name="is_veteran"/>
                                <field name="is_bringing_plus_one"/>
                                <field name="has_dd214_copy"/>
                                <field name="has_dd214_access"/>
                            </group>
                            <group>
                                <field name="physical_address"/>
                            </group>
                        </page>
                        <page string="Additional Details" name="details">
                            <group>
                                <field name="ssn"/>
                            </group>
                            <group>
                                <label for="notes" string="Internal Notes"/>
                                <br/>
                                <field name="notes" 
                                       nolabel="1" 
                                       colspan="2" 
                                       placeholder="Add internal notes about this lead..."/>
                            </group>
                        </page>
                    </notebook>

                </sheet>

                <!-- CHATTER - Must be OUTSIDE sheet, just one tag -->
                <chatter/>
                
            </form>
        </field>
    </record>


    <!-- ================================================= -->
    <!-- LEAD LIST VIEW -->
    <!-- ================================================= -->
    <record id="vac_event_lead_view_list" model="ir.ui.view">
        <field name="name">vac.event.lead.list</field>
        <field name="model">vac.event.lead</field>
        <field name="arch" type="xml">
            <list string="Leads" 
                  sample="1"
                  editable="bottom">
                <field name="name"/>
                <field name="first_name" optional="hide"/>
                <field name="last_name" optional="hide"/>
                <field name="email" widget="email"/>
                <field name="mobile" widget="phone" optional="show"/>
                <field name="whatsapp_number" optional="hide"/>
                <field name="birthday" optional="hide"/>
                <field name="branch_service_id" optional="show"/>
                <field name="current_va_disability_rating" optional="hide"/>
                <field name="is_current_client" optional="hide"/>
                <field name="is_veteran" optional="hide"/>
                <field name="has_dd214_copy" optional="hide"/>
                <field name="has_dd214_access" optional="hide"/>
                <field name="bam_user_id" options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_search_more': True}"/>
                <field name="crm_lead_id" column_invisible="1"/>
                <field name="stage_id" widget="badge"/>
                <field name="event_id" optional="hide"/>
                <field name="sponsor_id" optional="show"/>
                <field name="activity_ids" widget="list_activity"/>
            </list>
        </field>
    </record>


    <!-- ================================================= -->
    <!-- SOCIAL LEAD LIST VIEW                             -->
    <!-- Shows social_stage_id instead of stage_id        -->
    <!-- ================================================= -->
    <record id="vac_event_lead_view_social_list" model="ir.ui.view">
        <field name="name">vac.event.lead.social.list</field>
        <field name="model">vac.event.lead</field>
        <field name="arch" type="xml">
            <list string="Social Media Leads"
                  sample="1"
                  editable="bottom">
                <field name="name"/>
                <field name="first_name" optional="hide"/>
                <field name="last_name" optional="hide"/>
                <field name="email" widget="email"/>
                <field name="mobile" widget="phone" optional="show"/>
                <field name="whatsapp_number" optional="hide"/>
                <field name="birthday" optional="hide"/>
                <field name="branch_service_id" optional="show"/>
                <field name="current_va_disability_rating" optional="hide"/>
                <field name="is_current_client" optional="hide"/>
                <field name="is_veteran" optional="hide"/>
                <field name="has_dd214_copy" optional="hide"/>
                <field name="has_dd214_access" optional="hide"/>
                <field name="bam_user_id" options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_search_more': True}"/>
                <field name="social_stage_id" widget="badge" string="Stage"/>
                <field name="event_id" optional="hide"/>
                <field name="activity_ids" widget="list_activity"/>
            </list>
        </field>
    </record>


    <!-- ================================================= -->
    <!-- SOCIAL LEAD KANBAN VIEW                           -->
    <!-- Groups by social_stage_id (vac.social.lead.stage) -->
    <!-- ================================================= -->
    <record id="vac_event_lead_view_social_kanban" model="ir.ui.view">
        <field name="name">vac.event.lead.social.kanban</field>
        <field name="model">vac.event.lead</field>
        <field name="arch" type="xml">
            <kanban class="o_lead_kanban_view"
                    default_group_by="social_stage_id"
                    quick_create="false"
                    sample="1">

                <field name="name"/>
                <field name="email"/>
                <field name="mobile"/>
                <field name="whatsapp_number"/>
                <field name="branch_service_id"/>
                <field name="bam_user_id" options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_search_more': True}"/>
                <field name="social_stage_id"/>
                <field name="activity_ids"/>
                <field name="activity_state"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card d-flex flex-column">

                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary fw-bold">
                                        <field name="name"/>
                                    </div>
                                </div>
                            </div>

                            <div class="o_kanban_card_content">
                                <div class="d-flex align-items-center mb-1">
                                    <i class="fa fa-envelope me-2 text-muted" title="Email"/>
                                    <field name="email" widget="email"/>
                                </div>

                                <div t-if="record.mobile.value" class="d-flex align-items-center mb-1">
                                    <i class="fa fa-phone me-2 text-muted" title="Phone"/>
                                    <field name="mobile" widget="phone"/>
                                </div>

                                <div t-if="record.branch_service_id.value" class="d-flex align-items-center mb-1">
                                    <i class="fa fa-building me-2 text-muted" title="Branch/Service"/>
                                    <field name="branch_service_id"/>
                                </div>

                            </div>

                            <div class="o_kanban_card_footer mt-auto">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex">
                                        <field t-if="record.bam_user_id.value"
                                               name="bam_user_id"
                                               widget="many2one_avatar_user"
                                               options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_search_more': True}"/>
                                    </div>

                                    <div class="d-flex ms-auto">
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </t>
                </templates>

            </kanban>
        </field>
    </record>


    <!-- ================================================= -->
    <!-- LEAD ACTION -->
    <!-- ================================================= -->
    <record id="vac_event_lead_action" model="ir.actions.act_window">
        <field name="name">Leads</field>
        <field name="res_model">vac.event.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_my_leads': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No leads yet!
            </p>
            <p>
                Leads are automatically created when people register through your event links.
            </p>
        </field>
    </record>

    <record id="vac_event_lead_action_all" model="ir.actions.act_window">
        <field name="name">All Leads</field>
        <field name="res_model">vac.event.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <!-- ── Event Leads (only leads linked to an Event) ── -->
    <record id="vac_event_lead_action_event_only" model="ir.actions.act_window">
        <field name="name">Event Leads</field>
        <field name="res_model">vac.event.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('event_id', '!=', False)]</field>
        <field name="context">{'hide_social_stage': True, 'default_platform': 'event'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('vac_event_lead_view_kanban')}),
            (0, 0, {'view_mode': 'list',   'view_id': ref('vac_event_lead_view_list')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No event leads yet!</p>
            <p>Leads generated through event registration links will appear here.</p>
        </field>
    </record>

