    <record id="vac_event_action_vac" model="ir.actions.act_window">
        <field name="name">VAC's Events</field>
        <field name="res_model">vac.event</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain" eval="[('sponsor_id', '=', ref('vac_social_marketing.sponsor_vac'))]"/>
        <field name="context" eval="{'default_sponsor_name': 'VAC', 'default_sponsor_id': ref('vac_social_marketing.sponsor_vac')}"/>
