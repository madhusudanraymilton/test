        <field name="res_model">vac.event</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain" eval="[('sponsor_id', '=', ref('vac_social_marketing.sponsor_stacey_michelon'))]"/>
        <field name="context" eval="{'default_sponsor_name': 'Stacey Michelon', 'default_sponsor_id': ref('vac_social_marketing.sponsor_stacey_michelon')}"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No events for Stacey Michelon yet!</p>
