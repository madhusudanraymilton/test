    <record id="vac_event_action_webinar" model="ir.actions.act_window">
        <field name="name">Webinar Events</field>
        <field name="res_model">vac.event</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain" eval="[('sponsor_id', '=', ref('vac_social_marketing.sponsor_webinar'))]"/>
        <field name="context" eval="{'default_sponsor_name': 'Webinar', 'default_sponsor_id': ref('vac_social_marketing.sponsor_webinar')}"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No webinar events yet!</p>
        </field>
    </record>

</odoo>
