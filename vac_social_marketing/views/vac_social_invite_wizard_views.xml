<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="vac_social_invite_wizard_view_form" model="ir.ui.view">
        <field name="name">vac.social.invite.wizard.form</field>
        <field name="model">vac.social.invite.wizard</field>
        <field name="arch" type="xml">
            <form string="Share Campaign Link">
                <sheet>

                    <!-- Hidden technical fields -->
                    <field name="source_model"  invisible="1"/>
                    <field name="source_id"     invisible="1"/>
                    <field name="social_link"   invisible="1"/>
                    <field name="qr_image_url"  invisible="1"/>

                    <!-- Title -->
                    <div class="oe_title">
                        <h2 style="display:flex;align-items:center;gap:8px;">
                            <i class="fa fa-share-alt text-primary"/>
                            Share Registration Link
                        </h2>
                    </div>

                    <!-- QR code + link block (computed HTML) -->
                    <group>
                        <field name="share_html"
                               widget="html"
                               readonly="1"
                               nolabel="1"
                               sanitize="0"/>
                    </group>

                </sheet>

                <footer>
                    <button string="Copy Link"
                            name="action_copy_link"
                            type="object"
                            class="btn-primary"
                            icon="fa-clone"
                            invisible="not social_link"/>
                    <button string="Print QR"
                            name="action_print_qr"
                            type="object"
                            class="btn-secondary"
                            icon="fa-print"
                            invisible="not social_link"/>
                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
