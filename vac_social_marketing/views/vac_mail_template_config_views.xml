<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  LIST VIEW                                                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <record id="vac_mail_template_config_view_list" model="ir.ui.view">
        <field name="name">vac.mail.template.config.list</field>
        <field name="model">vac.mail.template.config</field>
        <field name="arch" type="xml">
            <list string="Email Templates">
                <field name="name"/>
                <field name="header_title"/>
                <field name="footer_phone"/>
                <field name="footer_email"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  FORM VIEW                                                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <record id="vac_mail_template_config_view_form" model="ir.ui.view">
        <field name="name">vac.mail.template.config.form</field>
        <field name="model">vac.mail.template.config</field>
        <field name="arch" type="xml">
            <form string="Email Template Builder">
                <sheet>

                    <!-- Template name banner -->
                    <div class="oe_title">
                        <label for="name" string="Template Name"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g. VAC Veterans Event Email"/>
                        </h1>
                    </div>

                    <notebook>

                        <!-- ══════════════════════════════════════════════ -->
                        <!--  TAB 1 — HEADER                               -->
                        <!-- ══════════════════════════════════════════════ -->
                        <page string="🖼️ Header" name="header">

                            <!-- HEADER 2-OPTION GUIDE -->
                            <table style="width:100%;border-collapse:collapse;margin-bottom:14px;font-size:13px;">
                                <tr>
                                    <td style="width:50%;padding:10px 14px;background:#f6f8f6;border:1px solid #c8d8c8;">
                                        <div style="font-weight:600;color:#3a6b3a;margin-bottom:6px;">
                                            <i class="fa fa-image me-1"/> Option 1 — Full Header Image
                                        </div>
                                        <div style="color:#555;line-height:1.6;">
                                            Upload only the <strong>Background Image</strong>.<br/>
                                            Logo and title text will <strong>not show</strong>.
                                        </div>
                                    </td>
                                    <td style="width:4px;background:#fff;border:0;"/>
                                    <td style="width:50%;padding:10px 14px;background:#f5f7fa;border:1px solid #c5cfe0;">
                                        <div style="font-weight:600;color:#2c4f80;margin-bottom:6px;">
                                            <i class="fa fa-th-large me-1"/> Option 2 — Logo + Title + Color
                                        </div>
                                        <div style="color:#555;line-height:1.6;">
                                            Leave <strong>Background Image empty</strong>.<br/>
                                            Upload Logo and fill in Title + Color.
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3" style="padding:7px 12px;background:#fdfbf0;border:1px solid #e8e0b0;font-size:12px;color:#7a6a20;">
                                        <i class="fa fa-exclamation-triangle me-1"/>
                                        <strong>Do not use both.</strong> If Background Image is uploaded, Logo and Title will not appear in the email.
                                    </td>
                                </tr>
                            </table>

                            <!-- WARNING: background image uploaded but no logo -->
                            <div class="alert alert-danger" role="status" style="font-size:13px;padding:8px 12px;"
                                 invisible="not header_bg_image or header_logo">
                                <i class="fa fa-exclamation-triangle me-1"/> Background image is set but <strong>no logo uploaded</strong> — the header will show only the background image with text.
                            </div>

                            <!-- INFO: background image active — logo will appear on top -->
                            <div class="alert alert-success" role="status" style="font-size:13px;padding:8px 12px;"
                                 invisible="not header_bg_image or not header_logo">
                                <i class="fa fa-check-circle me-1"/> <strong>Background image + Logo</strong> are both set. Logo and title will appear on top of the background image. ✓
                            </div>

                            <!-- INFO: no background image — using solid color -->
                            <div class="alert alert-info" role="status" style="font-size:13px;padding:8px 12px;"
                                 invisible="header_bg_image">
                                <i class="fa fa-paint-brush me-1"/> No background image — using <strong>Background Color</strong> below. Upload a Background Image to use a branded banner instead.
                            </div>

                            <group string="Logo">
                                <field name="header_logo"
                                       widget="image"
                                       options="{'size': [220, 80]}"
                                       string="Header Logo"
                                       help="This logo appears at the top centre of every email."/>
                                <field name="header_logo_filename" invisible="1"/>
                                <div class="alert alert-warning mt-1 mb-0" role="status" style="font-size:13px;padding:7px 12px;">
                                    <i class="fa fa-picture-o me-1" style="color:#f59e0b;"/> Upload logo at <strong>380 x 156 px</strong> — PNG with transparent background.
                                </div>
                            </group>

                            <group string="Background">
                                <group>
                                    <field name="header_bg_color"
                                           widget="color"
                                           string="Background Color"
                                           help="Used when no background image is uploaded"/>
                                    <field name="header_text_color"
                                           widget="color"
                                           string="Text Color"/>
                                </group>
                                <group>
                                    <field name="header_bg_image"
                                           widget="image"
                                           options="{'size': [300, 80]}"
                                           string="Background Image"
                                           help="Optional. Overrides the background color."/>
                                    <field name="header_bg_image_filename" invisible="1"/>
                                    <div class="alert alert-warning mt-1 mb-0" role="status" style="font-size:13px;padding:7px 12px;">
                                        <i class="fa fa-picture-o me-1" style="color:#f59e0b;"/> Upload at <strong>1240 x 192 px</strong> — JPG or PNG, keep main content in the centre.
                                    </div>
                                </group>
                            </group>

                            <group string="Text">
                                <field name="header_title"
                                       placeholder="Veterans Advocate Center"/>
                                <field name="header_subtitle"
                                       placeholder="Event Registration Confirmation"/>
                            </group>

                        </page>

                        <!-- ══════════════════════════════════════════════ -->
                        <!--  TAB 2 — BODY / MIDDLE                        -->
                        <!-- ══════════════════════════════════════════════ -->
                        <page string="✉️ Body" name="body">

                            <!-- Placeholder quick-reference -->
                            <div class="alert alert-info mb-4" role="status">
                                <strong><i class="fa fa-info-circle me-1"/> Available Placeholders</strong>
                                — copy and paste into the editor below:<br/>
                                <div class="mt-2" style="line-height:2.2;">
                                    <code style="background:#dbeafe;padding:2px 8px;border-radius:4px;">{{ object.name }}</code>
                                    <span class="text-muted ms-1 me-3">Registrant full name</span>
                                    <code style="background:#dbeafe;padding:2px 8px;border-radius:4px;">{{ object.email }}</code>
                                    <span class="text-muted ms-1 me-3">Registrant email</span>
                                    <code style="background:#dbeafe;padding:2px 8px;border-radius:4px;">{{ object.event_id.title_name }}</code>
                                    <span class="text-muted ms-1 me-3">Event title</span>
                                    <code style="background:#dbeafe;padding:2px 8px;border-radius:4px;">{{ object.event_id.date }}</code>
                                    <span class="text-muted ms-1 me-3">Event date</span>
                                    <code style="background:#dbeafe;padding:2px 8px;border-radius:4px;">{{ object.event_id.venue }}</code>
                                    <span class="text-muted ms-1">Venue</span>
                                </div>
                            </div>

                            <!-- Body description editor — large and clearly labelled -->
                            <div class="mb-4">
                                <h5 style="font-weight:700;color:#1f2937;margin-bottom:8px;">
                                    <i class="fa fa-pencil-square-o me-1"/> Email Body Description
                                </h5>
                                <p class="text-muted" style="font-size:13px;margin-bottom:10px;">
                                    Write the main content of your email here. Use the formatting toolbar to
                                    add headings, bullet points, links, and images. Paste any placeholder
                                    from the box above to personalise the message for each recipient.
                                </p>
                                <field name="body_html"
                                       nolabel="1"
                                       widget="html"/>
                            </div>

                            <group string="Body Background Image">
                                <group>
                                    <field name="body_bg_image"
                                           widget="image"
                                           options="{'size': [300, 120]}"
                                           string="Background Image"
                                           help="Upload an image (e.g. eagle, flag, military) — it will appear faded behind the body text."/>
                                    <field name="body_bg_image_filename" invisible="1"/>
                                    <div class="alert alert-warning mt-1 mb-0" role="status" style="font-size:13px;padding:7px 12px;">
                                        <i class="fa fa-picture-o me-1" style="color:#f59e0b;"/> Upload a dark/bold image (e.g. eagle, flag) at <strong>1240 x 1120 px</strong> — JPG under 300 KB.
                                    </div>
                                </group>
                                <group>
                                    <field name="body_bg_overlay"
                                           string="White Overlay Opacity"
                                           widget="float"
                                           invisible="not body_bg_image"
                                           help="0.0 = image fully visible | 1.0 = completely hidden. Use 0.80–0.92 for a soft watermark effect."/>
                                    <div class="alert alert-info mt-2" role="status"
                                         invisible="not body_bg_image">
                                        <i class="fa fa-lightbulb-o me-1"/> Set to <strong>0.88</strong> for best result.
                                    </div>
                                </group>
                            </group>
                        </page>

                        <!-- ══════════════════════════════════════════════ -->
                        <!--  TAB 3 — FOOTER                               -->
                        <!-- ══════════════════════════════════════════════ -->
                        <page string="📌 Footer" name="footer">

                            <!-- FOOTER 2-OPTION GUIDE -->
                            <table style="width:100%;border-collapse:collapse;margin-bottom:14px;font-size:13px;">
                                <tr>
                                    <td style="width:50%;padding:10px 14px;background:#f6f8f6;border:1px solid #c8d8c8;">
                                        <div style="font-weight:600;color:#3a6b3a;margin-bottom:6px;">
                                            <i class="fa fa-image me-1"/> Option 1 — Full Footer Image
                                        </div>
                                        <div style="color:#555;line-height:1.6;">
                                            Upload only the <strong>Full Footer Image</strong>.<br/>
                                            Logo, contact and buttons will <strong>not show</strong>.
                                        </div>
                                    </td>
                                    <td style="width:4px;background:#fff;border:0;"/>
                                    <td style="width:50%;padding:10px 14px;background:#f5f7fa;border:1px solid #c5cfe0;">
                                        <div style="font-weight:600;color:#2c4f80;margin-bottom:6px;">
                                            <i class="fa fa-th-large me-1"/> Option 2 — Logo + Contact + Buttons
                                        </div>
                                        <div style="color:#555;line-height:1.6;">
                                            Leave <strong>Full Footer Image empty</strong>.<br/>
                                            Upload Footer Logo and fill in contact info.
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3" style="padding:7px 12px;background:#fdfbf0;border:1px solid #e8e0b0;font-size:12px;color:#7a6a20;">
                                        <i class="fa fa-exclamation-triangle me-1"/>
                                        <strong>Do not use both.</strong> If Full Footer Image is uploaded, Logo, Contact and Buttons will not appear in the email.
                                    </td>
                                </tr>
                            </table>

                            <!-- WARNING: both set -->
                            <div class="alert alert-danger" role="status" style="font-size:13px;padding:8px 12px;"
                                 invisible="not footer_full_image or not footer_logo">
                                <i class="fa fa-exclamation-triangle me-1"/> <strong>Both Footer Logo and Full Footer Image are uploaded.</strong> Only the Full Image will show — your Logo is hidden. Remove one.
                            </div>

                            <!-- INFO: full footer image active -->
                            <div class="alert alert-warning" role="status" style="font-size:13px;padding:8px 12px;"
                                 invisible="not footer_full_image">
                                <i class="fa fa-eye-slash me-1"/> <strong>Full Footer Image is active.</strong> Logo, contact info and buttons below are all hidden in the email.
                            </div>

                            <!-- INFO: built-in footer active -->
                            <div class="alert alert-success" role="status" style="font-size:13px;padding:8px 12px;"
                                 invisible="footer_full_image">
                                <i class="fa fa-check-circle me-1"/> <strong>Built-in footer is active.</strong> Logo, contact info and buttons below are all visible in the email.
                            </div>

                            <group string="Footer Images">
                                <field name="footer_logo"
                                       widget="image"
                                       options="{'size': [180, 60]}"
                                       string="Footer Logo"/>
                                <field name="footer_logo_filename" invisible="1"/>
                                <div class="alert alert-warning mt-1 mb-3" role="status" style="font-size:13px;padding:7px 12px;">
                                    <i class="fa fa-picture-o me-1" style="color:#f59e0b;"/> Upload a <strong>square</strong> image at <strong>208 x 208 px</strong> — it will be shown as a circle.
                                </div>

                                <field name="footer_full_image"
                                       widget="image"
                                       options="{'size': [520, 140]}"
                                       string="Full Footer Image"/>
                                <field name="footer_full_image_filename" invisible="1"/>
                                <div class="alert alert-warning mt-1 mb-2" role="status" style="font-size:13px;padding:7px 12px;">
                                    <i class="fa fa-picture-o me-1" style="color:#f59e0b;"/> Upload at <strong>1240 px wide</strong> (any height) — JPG or PNG under 200 KB.
                                </div>
                                <div class="alert alert-info mt-2" role="status"
                                     invisible="not footer_full_image">
                                    When a full footer image is uploaded, only that image is shown in the email footer.
                                </div>
                            </group>

                            <group string="Appearance" invisible="footer_full_image">
                                <field name="footer_bg_color"
                                       widget="color"
                                       string="Background Color"/>
                                <field name="footer_text_color"
                                       widget="color"
                                       string="Text Color"/>
                                <field name="footer_accent_color"
                                       widget="color"
                                       string="Accent Color"/>
                                <field name="footer_tagline"
                                       placeholder="YOU SERVED, YOU DESERVE"/>
                                <field name="footer_message"
                                       placeholder="The right knowledge can change your claim journey."/>
                            </group>

                            <group string="Contact Information" invisible="footer_full_image">
                                <field name="footer_phone"
                                       placeholder="+1 877-822-2023"/>
                                <field name="footer_email"
                                       placeholder="info@veteransadvocatecenter.com"/>
                                <field name="footer_website"
                                       placeholder="veteransadvocatecenter.com"/>
                            </group>

                            <group string="Buttons" invisible="footer_full_image">
                                <field name="footer_show_buttons"/>
                                <div invisible="not footer_show_buttons"
                                     style="margin: 0 0 8px 0;">
                                    <div class="alert alert-info d-flex align-items-start gap-2 mb-2"
                                         role="status"
                                         style="border-left: 4px solid #0d6efd; border-radius:6px; padding:10px 14px;">
                                        <i class="fa fa-hand-pointer-o mt-1" style="font-size:16px; color:#0d6efd;"/>
                                        <div>
                                            <strong>Create Your Own Buttons</strong><br/>
                                            Click <strong>"Add a line"</strong> below to add as many buttons as you need.
                                            Each button has its own <em>Label</em>, <em>URL</em>, background colour,
                                            text colour and border colour. Drag the <i class="fa fa-bars"/> handle
                                            to reorder them.
                                        </div>
                                    </div>
                                    <field name="footer_button_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="label" placeholder="e.g. LEARN MORE"/>
                                            <field name="url"   placeholder="https://example.com"/>
                                            <field name="bg_color"     widget="color" string="Background"/>
                                            <field name="text_color"   widget="color" string="Text Color"/>
                                            <field name="border_color" widget="color" string="Border Color"/>
                                        </list>
                                    </field>
                                </div>
                            </group>
                        </page>

                        <!-- ══════════════════════════════════════════════ -->
                        <!--  TAB 4 — LIVE PREVIEW                         -->
                        <!-- ══════════════════════════════════════════════ -->
                        <page string="👁️ Live Preview" name="live_preview">
                            <div class="alert alert-info mb-3" role="status">
                                <i class="fa fa-eye me-2"/>
                                This preview shows the complete email with the
                                current header, body, and footer settings.
                            </div>
                            <div class="o_vac_email_preview"
                                 style="background:#f3f5f7;border:1px solid #dfe3e8;border-radius:8px;padding:24px;overflow:auto;">
                                <field name="preview_html"
                                       nolabel="1"
                                       readonly="1"
                                       widget="html"/>
                            </div>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  ACTION                                                     -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <record id="vac_mail_template_config_action" model="ir.actions.act_window">
        <field name="name">Email Templates</field>
        <field name="res_model">vac.mail.template.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first email template
            </p>
            <p>
                Build branded email templates with custom header, body, and footer.
                Assign a template to any event and all registration confirmation
                emails will match the template exactly.
            </p>
        </field>
    </record>

</odoo>
