<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_vac_lead_status_form" model="ir.ui.view">
        <field name="name">vac.lead.status.form</field>
        <field name="model">vac.lead.status</field>
        <field name="arch" type="xml">
            <form string="Lead Status">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Describe this status..." nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_vac_lead_status_list" model="ir.ui.view">
        <field name="name">vac.lead.status.list</field>
        <field name="model">vac.lead.status</field>
        <field name="arch" type="xml">
            <list string="Lead Status" editable="bottom" sample="1">
                <field name="name"/>
                <field name="description" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vac_lead_status" model="ir.actions.act_window">
        <field name="name">Lead Status</field>
        <field name="res_model">vac.lead.status</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first lead status
            </p>
            <p>
                Define custom statuses to track lead progress (e.g., Hot, Warm, Cold, Converted).
            </p>
        </field>
    </record>
</odoo>
