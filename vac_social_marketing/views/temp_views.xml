<odoo>
    <!--  
        CORRECTED EVENT LISTING PAGE
        This template properly checks for badge_background and displays custom images
    -->
    
    <template id="event_listing_page" name="Events Listing">
        <t t-call="web.login_layout">
            <div class="container-fluid" style="background-color: #f8f9fa;">
                
                <!--  Header Section  -->
                <div class="container py-4">
                    <div class="row mb-4">
                        <div class="col-12">
                            <h1 class="display-4 fw-bold">Events</h1>
                        </div>
                    </div>
                    
                    <!--  Filters Row  -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="d-flex gap-2 flex-wrap">
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary dropdown-toggle" type="button"> Type </button>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary dropdown-toggle" type="button"> Language </button>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary dropdown-toggle" type="button"> Topic </button>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary dropdown-toggle" type="button"> All countries </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!--  Events Grid  -->
                    <div class="row">
                        <t t-if="events">
                            <t t-foreach="events" t-as="event">
                                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                                    <a t-attf-href="/event/invite/#{event.id}" class="text-decoration-none">
                                        <div class="card h-100 shadow-sm hover-shadow" style="transition: all 0.3s;">
                                            
                                            <!--  CRITICAL: Check if badge_background exists (not empty)  -->
                                            <t t-set="has_background" t-value="event.badge_background and len(event.badge_background) > 0"/>
                                            
                                            <!--  Event Banner with Custom Background  -->
                                            <t t-if="has_background">
                                                <div class="position-relative event-banner">
                                                    <!--  Custom background image  -->
                                                    <img t-attf-src="/event/badge/#{event.id}" 
                                                         alt="Event Background" 
                                                         class="w-100" 
                                                         style="height: 200px; object-fit: cover;"/>
                                                    
                                                    <!--  Date Badge Overlay  -->
                                                    <div class="position-absolute top-0 end-0 m-3">
                                                        <div class="bg-white rounded-circle p-2 text-center shadow" style="width: 60px; height: 60px;">
                                                            <div class="fw-bold" style="font-size: 0.7rem; line-height: 1;">
                                                                <t t-esc="event.date.strftime('%b').upper()"/>
                                                            </div>
                                                            <div class="fw-bold" style="font-size: 1.2rem; line-height: 1;">
                                                                <t t-esc="event.date.strftime('%d')"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    
                                                    <!--  Event Type Icon Overlay  -->
                                                    <div class="position-absolute bottom-0 start-0 m-3">
                                                        <div class="bg-white rounded-circle p-3 shadow">
                                                            <i class="fa fa-graduation-cap fa-2x text-primary"/>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>
                                            
                                            <!--  Default Gradient Background (No Image)  -->
                                            <t t-else="">
                                                <div class="position-relative" style="height: 200px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                                    
                                                    <!--  Date Badge  -->
                                                    <div class="position-absolute top-0 end-0 m-3">
                                                        <div class="bg-white rounded-circle p-2 text-center" style="width: 60px; height: 60px;">
                                                            <div class="fw-bold" style="font-size: 0.7rem; line-height: 1;">
                                                                <t t-esc="event.date.strftime('%b').upper()"/>
                                                            </div>
                                                            <div class="fw-bold" style="font-size: 1.2rem; line-height: 1;">
                                                                <t t-esc="event.date.strftime('%d')"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    
                                                    <!--  Event Type Icon  -->
                                                    <div class="position-absolute bottom-0 start-0 m-3">
                                                        <div class="bg-white rounded-circle p-3">
                                                            <i class="fa fa-graduation-cap fa-2x text-primary"/>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>
                                            
                                            <!--  Event Details Card Body  -->
                                            <div class="card-body">
                                                <!--  Tags/Categories  -->
                                                <div class="mb-2">
                                                    <t t-if="event.stage_id">
                                                        <span class="badge bg-light text-dark me-1">
                                                            <t t-esc="event.stage_id.name"/>
                                                        </span>
                                                    </t>
                                                </div>
                                                
                                                <!--  Event Title  -->
                                                <h5 class="card-title text-dark mb-2" style="min-height: 50px;">
                                                    <t t-esc="event.title_name"/>
                                                </h5>
                                                
                                                <!--  Location  -->
                                                <p class="text-muted small mb-2" t-if="event.venue">
                                                    <i class="fa fa-map-marker me-1"/>
                                                    <t t-esc="event.venue[:50]"/>
                                                    <t t-if="len(event.venue) > 50">...</t>
                                                </p>
                                                
                                                <!--  Status Badge  -->
                                                <div class="mt-2">
                                                    <t t-if="event.stage_id">
                                                        <span class="badge bg-primary">
                                                            <t t-esc="event.stage_id.name"/>
                                                        </span>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            </t>
                        </t>
                        
                        <!--  No Events Message  -->
                        <t t-else="">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body text-center py-5">
                                        <i class="fa fa-calendar fa-5x text-muted mb-3"/>
                                        <h3 class="text-muted">No Events Available</h3>
                                        <p class="text-muted">There are no published events at the moment. Please check back later!</p>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
            
            <!--  Hover Effects CSS  -->
            <style>
                .hover-shadow:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
                }
                .event-banner {
                    overflow: hidden;
                }
            </style>
        </t>
    </template>
    
</odoo>