<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    
    <t t-name="vac_events.VacLeadStageButtons" owl="1">
        <style>
            .vac_lead_button {
                border: 1px solid #e9ecef !important;
                border-width: 1px !important;
                border-style: solid !important;
                border-color: #e9ecef !important;
                background-color: #ffffff !important;
                padding: 8px 12px !important;
                border-radius: 3px !important;
                display: inline-flex !important;
                flex-direction: row !important;
                align-items: center !important;
                min-width: 110px !important;
                max-width: 200px !important;
                cursor: pointer !important;
                box-sizing: border-box !important;
                margin: 0 !important;
                height: 35px !important;
            }
            .vac_lead_button:hover {
                background-color: #f8f9fa !important;
                border-color: #dee2e6 !important;
            }
            .vac_lead_button:focus {
                outline: none !important;
            }
            .vac_lead_icon {
                font-size: 24px !important;
                color: #875a7b !important;
                margin-right: 10px !important;
                flex-shrink: 0 !important;
                line-height: 1 !important;
            }
            .vac_lead_info {
                display: flex !important;
                flex-direction: column !important;
                align-items: flex-start !important;
                justify-content: center !important;
                flex: 1 !important;
            }
            .vac_lead_text {
                font-size: 13px !important;
                color: #212529 !important;
                line-height: 1.3 !important;
                white-space: nowrap !important;
                font-weight: 400 !important;
            }
            .vac_lead_value {
                font-size: 12px !important;
                font-weight: 700 !important;
                color: #212529 !important;
                line-height: 1.3 !important;
            }
        </style>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <t t-foreach="getStageData()" t-as="stage" t-key="stage.id">
                <button class="vac_lead_button" 
                        type="button"
                        t-on-click="() => this.openLeadsByStage(stage.id, stage.name)">
                    <i t-att-class="'fa ' + getStageIcon(stage.sequence) + ' vac_lead_icon'"/>
                    <div class="vac_lead_info">
                        <span class="vac_lead_text" t-esc="stage.name"/>
                        <span class="vac_lead_value">
                            <t t-esc="stage.count"/>
                        </span>
                    </div>
                </button>
            </t>
        </div>
    </t>
    
</templates>