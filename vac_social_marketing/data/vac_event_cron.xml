<odoo>
    <data noupdate="1">
        <record id="ir_cron_vac_event_auto_publish" model="ir.cron">
            <field name="name">VAC Events: Auto Publish / Unpublish</field>
            <field name="model_id" ref="model_vac_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_publish()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Social: Facebook auto-stage cron -->
        <record id="ir_cron_vac_social_fb_auto_stage" model="ir.cron">
            <field name="name">VAC Social FB: Auto Stage (Draft → Published → Ongoing → Completed)</field>
            <field name="model_id" ref="model_vac_social_fb"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_stage()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Social: Instagram auto-stage cron -->
        <record id="ir_cron_vac_social_ing_auto_stage" model="ir.cron">
            <field name="name">VAC Social ING: Auto Stage (Draft → Published → Ongoing → Completed)</field>
            <field name="model_id" ref="model_vac_social_ing"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_stage()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Social: Offices auto-stage cron -->
        <record id="ir_cron_vac_social_office_auto_stage" model="ir.cron">
            <field name="name">VAC Social Offices: Auto Stage (Draft → Published → Ongoing → Completed)</field>
            <field name="model_id" ref="model_vac_social_office"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_stage()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>