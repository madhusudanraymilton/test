<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="email_template_event_registration" model="mail.template">

        <field name="name">Event Registration Confirmation</field>
        <field name="model_id" ref="vac_social_marketing.model_vac_event_lead"/>
        <field name="subject">✅ Registration Confirmed – {{ object.event_id.title_name }}</field>
        <field name="email_from">ayesha.chowdhury5670@gmail.com</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="auto_delete" eval="True"/>

        <field name="body_html" type="html">
<![CDATA[
<div style="font-family:Arial,sans-serif;max-width:600px;margin:auto;
            border:1px solid #e0e0e0;border-radius:8px;overflow:hidden;">

    <div style="background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);
                padding:35px 30px;text-align:center;">
        <h1 style="color:white;margin:0;font-size:28px;">
            🎉 Registration Confirmed!
        </h1>
    </div>

    <div style="padding:35px 30px;">
        <p style="font-size:16px;color:#333;">
            Dear <strong>{{ object.name }}</strong>,
        </p>
        <p style="color:#555;">
            Thank you for registering for
            <strong>{{ object.event_id.title_name }}</strong>.
            We are thrilled to have you join us!
        </p>

        <table style="width:100%;border-collapse:collapse;margin:25px 0;">
            <tr style="background:#f8f9fa;">
                <td style="padding:12px 15px;font-weight:bold;
                           border:1px solid #dee2e6;width:35%;color:#444;">Full Name</td>
                <td style="padding:12px 15px;border:1px solid #dee2e6;color:#555;">
                    {{ object.name }}</td>
            </tr>
            <tr>
                <td style="padding:12px 15px;font-weight:bold;
                           border:1px solid #dee2e6;color:#444;">Email</td>
                <td style="padding:12px 15px;border:1px solid #dee2e6;color:#555;">
                    {{ object.email }}</td>
            </tr>
            <tr style="background:#f8f9fa;">
                <td style="padding:12px 15px;font-weight:bold;
                           border:1px solid #dee2e6;color:#444;">Mobile</td>
                <td style="padding:12px 15px;border:1px solid #dee2e6;color:#555;">
                    {{ object.mobile }}</td>
            </tr>
            <tr>
                <td style="padding:12px 15px;font-weight:bold;
                           border:1px solid #dee2e6;color:#444;">Event</td>
                <td style="padding:12px 15px;border:1px solid #dee2e6;color:#555;">
                    {{ object.event_id.title_name }}</td>
            </tr>
            <tr style="background:#f8f9fa;">
                <td style="padding:12px 15px;font-weight:bold;
                           border:1px solid #dee2e6;color:#444;">Date</td>
                <td style="padding:12px 15px;border:1px solid #dee2e6;color:#555;">
                    {{ object.event_id.date }}</td>
            </tr>
            <tr>
                <td style="padding:12px 15px;font-weight:bold;
                           border:1px solid #dee2e6;color:#444;">Venue</td>
                <td style="padding:12px 15px;border:1px solid #dee2e6;color:#555;">
                    {% if object.event_id.venue %}{{ object.event_id.venue }}{% else %}To be announced{% endif %}
                </td>
            </tr>
        </table>

        <div style="background:#e8f4fd;border-left:4px solid #667eea;
                    padding:18px 20px;border-radius:4px;margin:25px 0;">
            <strong style="color:#333;">📌 What's Next?</strong>
            <p style="margin:10px 0 0;color:#555;line-height:1.6;">
                We will send you full event details and reminders as the date approaches.
                Keep an eye on your inbox!
            </p>
        </div>

        <p style="color:#555;">
            Questions? Contact us at
            <a href="mailto:ayesha.chowdhury5670@gmail.com" style="color:#667eea;">
                ayesha.chowdhury5670@gmail.com
            </a>
        </p>

        <p style="margin-top:35px;color:#333;">
            Warm regards,<br/>
            <strong>The Events Team</strong>
        </p>
    </div>

    <div style="background:#f8f9fa;padding:18px 30px;text-align:center;
                font-size:12px;color:#6c757d;border-top:1px solid #e0e0e0;">
        Sent from
        <a href="mailto:ayesha.chowdhury5670@gmail.com" style="color:#667eea;">
            ayesha.chowdhury5670@gmail.com
        </a>.
        Please do not reply directly.
    </div>

</div>
]]>
        </field>
    </record>

</odoo>
