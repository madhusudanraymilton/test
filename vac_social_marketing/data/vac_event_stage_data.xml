<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Event Stages -->
        <record id="vac_event_stage_draft" model="vac.event.stage">
            <field name="name">Draft</field>
            <field name="sequence">10</field>
            <field name="fold">False</field>
            <field name="color">0</field>
            <field name="description">Event is being planned</field>
        </record>
        
        <record id="vac_event_stage_published" model="vac.event.stage">
            <field name="name">Published</field>
            <field name="sequence">20</field>
            <field name="fold">False</field>
            <field name="color">1</field>
            <field name="description">Event is published</field>
        </record>
        
        <record id="vac_event_stage_ongoing" model="vac.event.stage">
            <field name="name">Ongoing</field>
            <field name="sequence">30</field>
            <field name="fold">False</field>
            <field name="color">3</field>
            <field name="description">Event is happening</field>
        </record>
        
        <record id="vac_event_stage_completed" model="vac.event.stage">
            <field name="name">Completed</field>
            <field name="sequence">40</field>
            <field name="fold">False</field>
            <field name="color">10</field>
            <field name="description">Event has concluded</field>
        </record>
        
        <record id="vac_event_stage_cancelled" model="vac.event.stage">
            <field name="name">Cancelled</field>
            <field name="sequence">50</field>
            <field name="fold">True</field>
            <field name="color">8</field>
            <field name="description">Event was cancelled</field>
        </record>
        
        <!-- Event Templates -->
        <record id="vac_event_template_health_fair" model="vac.event.templates">
            <field name="name">Health Fair Template</field>
            <field name="description">Template for health fairs</field>
            <field name="default_venue">VAC Healthcare Main Office</field>
            <field name="default_timezone_id">Asia/Dhaka</field>
        </record>
        
        <record id="vac_event_template_webinar" model="vac.event.templates">
            <field name="name">Webinar Template</field>
            <field name="description">Template for webinars</field>
            <field name="default_venue">Online - Zoom</field>
            <field name="default_timezone_id">Asia/Dhaka</field>
        </record>
        
        <record id="vac_event_template_product_launch" model="vac.event.templates">
            <field name="name">Product Launch Template</field>
            <field name="description">Template for product launches</field>
            <field name="default_timezone_id">Asia/Dhaka</field>
        </record>
        
    </data>
</odoo>