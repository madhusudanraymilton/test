<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- CUSTOM PAPER FORMAT -->
    <record id="paperformat_delivery_challan" model="report.paperformat">
        <field name="name">Delivery Challan A4</field>
        <field name="default">False</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line">False</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- REPORT ACTION-->
    <record id="action_report_delivery_challan" model="ir.actions.report">
        <field name="name">Delivery Challan</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zencore_clms.report_delivery_challan</field>
        <field name="report_file">zencore_clms.report_delivery_challan</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="zencore_clms.paperformat_delivery_challan"/>
    </record>

    <!-- STYLES -->
    <template id="report_delivery_challan_style">
        <style>
      @page {
        size: A4;
        margin: 0cm 0cm 2cm 0cm;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: '72', 'Roboto', 'DejaVu Sans', sans-serif;
        font-size: 9pt;
        color: #32363A;
        background: #FFFFFF;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* ── Header  */
      .header-wrap {
        display: table;
        width: 100%;
        background: #FFFFFF;
        border-bottom: 3pt solid #0070F2;
        padding: 12pt 2cm 10pt 2cm;
      }
      .header-left  { display: table-cell; vertical-align: middle; width: 55%; }
      .header-right { display: table-cell; vertical-align: middle; width: 45%; text-align: right; }
      .co-name    { font-size: 13pt; font-weight: bold; color: #32363A; margin-bottom: 3pt; }
      .co-addr    { font-size: 8pt; color: #6A6D70; line-height: 1.7; }
      .co-contact { font-size: 7.5pt; color: #6A6D70; margin-top: 2pt; }
      .doc-title  { font-size: 18pt; font-weight: 300; color: #0070F2; letter-spacing: 0.5pt; }
      .doc-sub    { font-size: 7.5pt; color: #6A6D70; margin-top: 2pt; }

      /* ── Body padding  */
      .body { padding: 12pt 2cm; }

      /* ── Two-column row (div-based)  */
      .two-col   { display: table; width: 100%; margin-bottom: 12pt; }
      .col-left  { display: table-cell; width: 50%; vertical-align: top; padding-right: 6pt; }
      .col-right { display: table-cell; width: 50%; vertical-align: top; padding-left: 6pt; }

      /* ── Div card (rounded corners, works in wkhtmltopdf)  */
      .card {
        border: 1pt solid #E0E0E0;
        border-radius: 6pt;
        overflow: hidden;
        background: #FFFFFF;
      }
      .card-header {
        background: #F5F6F7;
        border-bottom: 1pt solid #E0E0E0;
        padding: 5pt 10pt;
        font-size: 8pt;
        font-weight: 600;
        color: #32363A;
        letter-spacing: 0.3pt;
      }
      .card-body { padding: 9pt 11pt; }

      .buyer-name { font-size: 10pt; font-weight: 600; color: #32363A; margin-bottom: 3pt; }
      .buyer-addr { font-size: 8pt; color: #6A6D70; line-height: 1.8; }
      .buyer-meta { font-size: 8pt; color: #32363A; line-height: 1.7; margin-top: 4pt; }

      /* ── Div-based kv rows inside a card  */
      .kv-row {
        display: table;
        width: 100%;
        border-bottom: 1pt solid #E0E0E0;
      }
      .kv-row:last-child { border-bottom: none; }
      .kv-label {
        display: table-cell;
        width: 42%;
        background: #F5F6F7;
        border-right: 1pt solid #E0E0E0;
        padding: 4pt 8pt;
        font-size: 8pt;
        font-weight: 600;
        color: #6A6D70;
        vertical-align: top;
      }
      .kv-value {
        display: table-cell;
        background: #FFFFFF;
        padding: 4pt 8pt;
        font-size: 8pt;
        color: #32363A;
        vertical-align: top;
      }

      /* ── Section card (accent left border + rounded)  */
      .sec-card {
        border: 1pt solid #E0E0E0;
        border-radius: 6pt;
        overflow: hidden;
        background: #FFFFFF;
        margin-bottom: 12pt;
      }
      .sec-card-header {
        background: #F5F6F7;
        border-bottom: 1pt solid #E0E0E0;
        border-left: 2px solid #0070F2;
        padding: 5pt 10pt;
        font-size: 8pt;
        font-weight: 600;
        color: #32363A;
        letter-spacing: 0.3pt;
      }

      /* ── Goods table  */
      .goods-card {
        border: 1pt solid #E0E0E0;
        border-radius: 6pt;
        overflow: hidden;
        margin-bottom: 12pt;
      }
      .goods-card-header {
        background: #F5F6F7;
        border-bottom: 1pt solid #E0E0E0;
        border-left: 2px solid #0070F2;
        padding: 5pt 10pt;
        font-size: 8pt;
        font-weight: 600;
        color: #32363A;
        letter-spacing: 0.3pt;
      }
      table.goods { width: 100%; border-collapse: collapse; font-size: 8.5pt; }
      table.goods thead th {
        background: #F5F6F7;
        color: #32363A;
        font-weight: 600;
        font-size: 8pt;
        padding: 5pt 8pt;
        border-bottom: 2pt solid #0070F2;
        border-right: 1pt solid #E0E0E0;
        text-align: left;
      }
      table.goods thead th:last-child { border-right: none; }
      table.goods thead th.center { text-align: center; }
      table.goods thead th.right  { text-align: right; }
      table.goods tbody tr:nth-child(even) { background: #F5F6F7; }
      table.goods tbody tr:nth-child(odd)  { background: #FFFFFF; }
      table.goods tbody td {
        padding: 4pt 8pt;
        border-bottom: 1pt solid #E0E0E0;
        border-right: 1pt solid #E0E0E0;
        vertical-align: middle;
      }
      table.goods tbody td:last-child { border-right: none; }
      table.goods tbody td.center { text-align: center; }
      table.goods tbody td.right  { text-align: right; }
      table.goods tfoot td {
        background: #EBF4FF;
        padding: 5pt 8pt;
        font-weight: 700;
        font-size: 9pt;
        border-top: 2pt solid #0070F2;
        border-right: 1pt solid #E0E0E0;
        color: #32363A;
      }
      table.goods tfoot td:last-child { border-right: none; }
      table.goods tfoot td.center { text-align: center; }
      table.goods tfoot td.right  { text-align: right; }
      table.goods tfoot td.blue   { color: #0070F2; text-align: right; }

      /* ── Signature  */
      .sig-wrap  { display: table; width: 100%; margin-bottom: 4pt; }
      .sig-left  {
        display: table-cell; width: 55%; vertical-align: top;
        background: #F5F6F7;
        border: 1pt solid #E0E0E0;
        border-right: none;
        border-radius: 6pt 0 0 6pt;
        padding: 0;
        font-size: 7.5pt; color: #6A6D70; font-style: italic; line-height: 1.6;
      }
      .sig-left-inner     { display: table; width: 100%; height: 100%; min-height: 80pt; }
      .sig-left-top-cell  { display: table-cell; padding: 12pt 14pt 0 14pt; vertical-align: top; }
      .sig-left-spacer    { display: table-row; height: 100%; }
      .sig-left-bot-cell  { display: table-cell; vertical-align: bottom; padding: 0 14pt 12pt 14pt; }
      .sig-right {
        display: table-cell; width: 45%; vertical-align: bottom; text-align: center;
        background: #FFFFFF;
        border: 1pt solid #E0E0E0;
        border-radius: 0 6pt 6pt 0;
        padding: 10pt 14pt;
        min-height: 80pt;
      }
      .sig-image  { max-height: 50pt; max-width: 160pt; margin-bottom: 4pt; display: block; margin-left: auto; margin-right: auto; }
      .sig-line   { border-bottom: 1.5pt solid #0070F2; width: 160pt; margin: 0 auto 4pt auto; }
      .sig-title  { font-size: 9pt; font-weight: 600; color: #32363A; }
      .sig-behalf { font-size: 8pt; color: #6A6D70; }

      /* ── Footer  */
      .doc-footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        display: table;
        width: 100%;
        background: #F5F6F7;
        border-top: 1pt solid #E0E0E0;
        padding: 4pt 2cm;
        font-size: 7pt; color: #6A6D70;
      }
      .doc-footer-left  { display: table-cell; vertical-align: middle; text-align: left; }
      .doc-footer-right { display: table-cell; vertical-align: middle; text-align: right; }
        </style>
    </template>

    <!-- 
       MAIN TEMPLATE
       Field mapping summary:
       ─────────────────────────────────────────────────────────────────────
       Buyer Name        → move.partner_id.name                (res.partner)
       Buyer Address     → move.partner_id.street/city/zip     (res.partner)
       IRC No            → buyer.customer_irc                  (res.partner via zencore_lc)
       TIN               → move.partner_id.vat                 (Odoo default)
       ATN No            → buyer.customer_atn                  (res.partner via zencore_lc)
       Challan No        → move.name                           (invoice number)
       Challan Date      → move.invoice_date                   (invoice date)
       PI Details        → so.name + so.date_order             (sale.order)
       LC Details        → lc.customer_lc_number + lc.customer_lc_date   (zencore.lc)
       Export LC Details → lc.lc_number + lc.lc_date                    (zencore.lc)
       Gross Weight      → placeholder (no value yet) -->
    <!-- DOCUMENT TEMPLATE -->
    <template id="report_delivery_challan_document">

                <t t-set="buyer" t-value="move.partner_id"/>
                <t t-set="so" t-value="move.invoice_line_ids.mapped('sale_line_ids.order_id')[:1]"/>
                <t t-set="lc" t-value="so.clm_lc_id if so and 'clm_lc_id' in so._fields else False"/>
                <t t-set="company" t-value="move.company_id"/>

                <!--
                    Use the Sales LC snapshot fields first because those values are
                    stored directly on the related PI/SO. Fall back to the linked LC
                    record for older orders or records created before the snapshot
                    fields were introduced.
                -->
                <t t-set="customer_lc_number"
                   t-value="(so.so_customer_lc_number if so and 'so_customer_lc_number' in so._fields else False) or (lc.customer_lc_number if lc and 'customer_lc_number' in lc._fields else False)"/>
                <t t-set="customer_lc_date"
                   t-value="(so.so_customer_lc_date if so and 'so_customer_lc_date' in so._fields else False) or (lc.customer_lc_date if lc and 'customer_lc_date' in lc._fields else False)"/>
                <t t-set="export_lc_number"
                   t-value="(so.so_lc_num_ex if so and 'so_lc_num_ex' in so._fields else False) or (lc.lc_number if lc and 'lc_number' in lc._fields else False)"/>
                <t t-set="export_lc_date"
                   t-value="(so.so_lc_date_ex if so and 'so_lc_date_ex' in so._fields else False) or (lc.lc_date if lc and 'lc_date' in lc._fields else False)"/>

                <div class="page dc-page">

                    <!-- 1. HEADER  -->
                    <div class="header-wrap">
                        <div class="header-left">
                            <div class="co-name">
                                <t t-esc="company.name"/>
                            </div>

                            <div class="co-addr">
                                <t t-esc="company.street or ''"/>
                                <br/>
                                <t t-esc="(company.city or '') + (', ' + company.country_id.name if company.country_id else '')"/>
                            </div>

                            <div class="co-contact">
            T: <t t-esc="company.phone or ''"/>
                            <span style="padding-left: 10pt;">E:</span>
                            <t t-esc="company.email or ''"/>
                        </div>
                    </div>

                    <div class="header-right">
                        <div class="doc-title">DELIVERY CHALLAN</div>
                        <div class="doc-sub">LC DOCUMENT SET</div>
                    </div>
                </div>

                <div class="body">

                    <!--  2. CONSIGNEE / BUYER  |  DOCUMENT REFERENCE  -->
                    <div class="two-col">

                        <div class="col-left">
                            <div class="card">
                                <div class="card-header">CONSIGNEE / BUYER</div>
                                <div class="card-body">

                                    <div class="buyer-name">
                                        <t t-esc="buyer.name"/>
                                    </div>

                                    <div class="buyer-addr">
                                        <t t-if="buyer.street">
                                            <t t-esc="buyer.street"/>
                                            <br/>
                                        </t>
                                        <t t-if="buyer.street2">
                                            <t t-esc="buyer.street2"/>
                                            <br/>
                                        </t>
                                        <t t-if="buyer.city or buyer.zip">
                                            <t t-esc="(buyer.city or '') + (' ' + buyer.zip if buyer.zip else '')"/>
                                            <t t-if="buyer.country_id">,
                                                <t t-esc="buyer.country_id.name"/>
                                            </t>
                                            <br/>
                                        </t>
                                    </div>

                                    <div class="buyer-meta">
                                        <t t-if="buyer.customer_irc">
                                            <strong>IRC No:</strong>
                                            <span style="padding-left: 3pt;">
                                                <t t-esc="buyer.customer_irc"/>
                                            </span>
                                            <br/>
                                        </t>

                                        <t t-if="buyer.vat">
                                            <strong>TIN:</strong>
                                            <span style="padding-left: 3pt;">
                                                <t t-esc="buyer.vat"/>
                                            </span>
                                            <br/>
                                        </t>

                                        <t t-if="buyer.customer_atn">
                                            <strong>ATN:</strong>
                                            <span style="padding-left: 3pt;">
                                                <t t-esc="buyer.customer_atn"/>
                                            </span>
                                        </t>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <div class="col-right">
                            <div class="card">
                                <div class="card-header">DOCUMENT REFERENCE</div>

                                <div class="kv-row">
                                    <div class="kv-label">Challan No.</div>
                                    <div class="kv-value">
                                        <strong>
                                            <t t-esc="move.name"/>
                                        </strong>
                                    </div>
                                </div>

                                <div class="kv-row">
                                    <div class="kv-label">Challan Date</div>
                                    <div class="kv-value">
                                        <t t-esc="move.invoice_date" t-options='{"widget": "date", "format": "dd-MMM-yyyy"}'/>
                                    </div>
                                </div>

                                <div class="kv-row">
                                    <div class="kv-label">PI Details</div>
                                    <div class="kv-value">
                                        <t t-if="so">
                                            <t t-esc="so.name"/>
                                            <span style="padding: 0 3pt;">dated</span>
                                            <t t-esc="so.date_order" t-options='{"widget": "date", "format": "dd-MMM-yyyy"}'/>
                                        </t>
                                        <t t-else="">—</t>
                                    </div>
                                </div>

                                <div class="kv-row">
                                    <div class="kv-label">LC Details</div>
                                    <div class="kv-value">
                                        <t t-if="customer_lc_number">
                                            <t t-esc="customer_lc_number"/>
                                            <t t-if="customer_lc_date">
                                                <span style="padding: 0 3pt;">dated</span>
                                                <t t-esc="customer_lc_date.strftime('%d-%b-%y').upper()"/>
                                            </t>
                                        </t>
                                        <t t-else="">-</t>
                                    </div>
                                </div>

                                <div class="kv-row">
                                    <div class="kv-label">Export LC Details</div>
                                    <div class="kv-value">
                                        <t t-if="export_lc_number">
                                            <t t-esc="export_lc_number"/>
                                            <t t-if="export_lc_date">
                                                <span style="padding: 0 3pt;">dated</span>
                                                <t t-esc="export_lc_date.strftime('%d-%b-%y').upper()"/>
                                            </t>
                                        </t>
                                        <t t-else="">-</t>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div><!-- /two-col -->

                    <!--  3. GOODS TABLE  -->
                    <div class="goods-card">
                        <div class="goods-card-header">GOODS DETAILS</div>
                        <table class="goods">
                            <thead>
                                <tr>
                                    <th style="width:35%;">Item Description</th>
                                    <th class="center" style="width:13%;">Delivery Date</th>
                                    <th class="center" style="width:15%;">DO No.</th>
                                    <th class="center" style="width:8%;">Bags</th>
                                    <th class="right" style="width:12%;">Net Weight (KG)</th>
                                    <th class="right" style="width:17%;">Gross Weight (KG)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="move.invoice_line_ids" t-as="line">
                                    <t t-if="line.display_type == 'product'">
                                        <tr>
                                            <td>
                                                <t t-esc="line.product_id.description_sale or line.product_id.name"/>
                                            </td>
                                            <td class="center">
                                                <t t-esc="move.invoice_date" t-options='{"widget": "date", "format": "dd-MMM-yyyy"}'/>
                                            </td>
                                            <td class="center">
                                                <t t-esc="move.name"/>
                                            </td>
                                            <td class="center">
                                                <t t-esc="int((line.quantity or 0.0) / 50)"/>
                                            </td>
                                            <td class="right">
                                                <t t-esc="'{:,.0f}'.format(line.quantity)"/>
                                            </td>
                                            <td class="right">&#160;</td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                            <tfoot>
                                <t t-set="product_lines" t-value="move.invoice_line_ids.filtered(lambda l: l.display_type == 'product')"/>
                                <tr>
                                    <td>
                                        <strong>TOTAL</strong>
                                    </td>
                                    <td></td>
                                    <td></td>
                                    <td class="center">
                                        <t t-esc="int((sum(product_lines.mapped('quantity')) or 0.0) / 50)"/>
                                    </td>
                                    <td class="blue">
                                        <t t-esc="'{:,.0f}'.format(sum(product_lines.mapped('quantity')))"/>
 KG
                                    </td>
                                    <td class="blue">&#160;</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!--  4. SIGNATURE ROW  -->
                    <div class="sig-wrap">

                        <div class="sig-left">
                            <div class="sig-left-inner">
                                <div>
                                    <div class="sig-left-top-cell">
                                        <strong>Received the above goods in good condition for handling / delivery.</strong>
                                    </div>
                                </div>

                                <div class="sig-left-spacer"></div>

                                <div>
                                    <div class="sig-left-bot-cell">
                                        <t t-esc="buyer.name"/>
                                        <br/>
                                        Consignee Signature with Seal
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="sig-right">
                            <div style="height: 45pt;"></div>

                            <div class="sig-line"></div>

                            <div class="sig-title">Authorized Signature</div>

                            <div class="sig-behalf">
                                On behalf of <t t-esc="company.name"/>
                            </div>
                        </div>

                    </div>

                </div><!-- /body -->

                <!-- FOOTER -->
                <div class="doc-footer">
                    <div class="doc-footer-left">
                        <strong>
                            <t t-esc="company.name"/>
                        </strong>
                        <span style="padding: 0 5pt;">|</span>
                        Delivery Challan — LC Document Set
                        <span style="padding: 0 5pt;">|</span>
                        CONFIDENTIAL
                    </div>

                    <div class="doc-footer-right">
                        Page <span class="page"></span> of <span class="topage"></span>
                    </div>
                </div>

            </div><!-- /page -->
    </template>

    <!-- MAIN TEMPLATE -->
    <template id="report_delivery_challan">
        <t t-call="web.html_container">
            <t t-call="zencore_clms.report_delivery_challan_style"/>
            <t t-foreach="docs" t-as="move">
                <t t-call="zencore_clms.report_delivery_challan_document"/>
            </t>
        </t>
    </template>

</odoo>